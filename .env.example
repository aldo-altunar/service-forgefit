PORT= puerto en el que se ejecuta la aplicación
ENV= entorno de ejecución (development, production, etc.)

DB_HOST= host de la base de datos
DB_PORT= puerto de la base de datos
DB_USER= usuario de la base de datos
DB_PASSWORD= contraseña de la base de datos
DB_NAME = nombre de la base de datos

ADMIN_BOOTSTRAP_TOKEN= token de arranque para el administrador

JWT_SECRET= clave secreta para JWT
JWT_EXPIRATION_HOURS= tiempo de expiración del token JWT en horas

